# Copier en .env.local (jamais commité). Valeurs réelles : variables d'environnement Vercel
# (Preview = staging, Production = production), jamais dans le dépôt.
# Valeurs locales : `pnpm exec supabase status` après `pnpm db:start`.

# Public (visible du navigateur)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Serveur uniquement : ne jamais préfixer par NEXT_PUBLIC_, ne jamais importer côté client
SUPABASE_SECRET_KEY=
